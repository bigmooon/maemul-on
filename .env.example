# 매물온 환경 변수 예시
#
# 이 파일에는 **이름과 설명만** 둔다. 실제 값을 넣지 않는다.
# 복사: cp .env.example .env   (.env는 커밋하지 않는다)
#
# Client Secret과 token은 서버에서만 다룬다. URL·로그·LLM 요청·데모에 노출하지 않는다.

# --- 실행 환경 --------------------------------------------------------------
# local-fake | local-live-ai | staging | production
# 환경 이름으로 보안 규칙을 끄지 않는다. adapter와 endpoint만 달라진다.
APP_ENV=local-fake

# --- 네이버 로그인 (TASK-0008) ----------------------------------------------
# 네이버 개발자센터에서 발급. callback URL은 allowlist에 등록한 값과 일치해야 한다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=http://localhost:8000/auth/naver/callback

# --- 데이터베이스 (TASK-0002) -----------------------------------------------
# 아직 사용하지 않는다. DB 계층 추가 시 활성화한다.
# DATABASE_URL=postgresql+psycopg://maemul:password@localhost:5432/maemul_on

# --- LLM (TASK-0011 이후) ---------------------------------------------------
# 고객 연락처·상담 원문을 외부 API에 기본 전송하지 않는다.
# 월 10만 원 예산 내 일별 사용 상한을 설정한다.
# LLM_API_KEY=
# LLM_MODEL_ID=
# LLM_DAILY_BUDGET_KRW=
